<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/surface">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 Pick Installed App on Phone"
        android:textColor="@color/on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap any app to block it immediately. Use the search bar to find apps fast."
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <!-- Search Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="🔍 Search installed apps (e.g. Sony LIV)"
        app:boxCornerRadiusBottomEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusTopStart="10dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearchApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Apps List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPickerApps"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/tvNoAppsFound"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:gravity="center"
        android:text="No installed apps match your search."
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
